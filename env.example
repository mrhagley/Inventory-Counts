# Copy this file to .env for local use. Never commit .env.
# On Railway, set these in the service's Variables tab instead.

# Required. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Strongly recommended. Technicians enter this once on their phone.
# Without it, anyone who finds the link can spend your API credit.
ACCESS_CODE=

# Only needed if your API key is not scoped to a workspace (the API then returns a
# "must include the anthropic-workspace-id header" error). A key created inside a
# workspace does not need this.
# ANTHROPIC_WORKSPACE_ID=

# Optional. Defaults to claude-sonnet-5-5. Use a larger model for harder photos.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Counts allowed per minute from one IP address. Default 20.
# RATE_LIMIT_PER_MINUTE=20

# Email submissions (optional). When all three of the first two are set, the
# Session tab shows a "Submit and email" button.
# Create a key at https://resend.com
RESEND_API_KEY=
# Who receives the email. Separate several addresses with commas.
EMAIL_TO=
# Optional. Photos are emailed here in a separate email, and the spreadsheet goes only to
# EMAIL_TO. Leave empty to send everything to EMAIL_TO in one email.
PHOTO_EMAIL_TO=
# The sender. Until you verify your own domain in Resend, leave this unset: the
# default (onboarding@resend.dev) can only deliver to the email on your Resend account.
# EMAIL_FROM=Inventory Count <counts@yourcompany.com>
